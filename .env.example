# .env
# --- AI Provider Configuration ---
# LLM_BACKEND Options: openai, local
LLM_BACKEND=local
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_MODEL_NAME_FALLBACK1=gpt-5-nano
OPENAI_MODEL_NAME_FALLBACK2=gpt-5.4-nano
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LOCAL_MODEL_NAME=ollama/qwen2.5-coder:3b
# OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://host.k3d.internal:11434

# --- GitHub Enterprise Integration ---
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=username/microservices-demo

OPENSMITH_CONFIG_PATH=.opensmith/config.json
AUTORESOLVE_API_KEY=mock-production-token
X_API_KEY=mock-production-token
API_KEY=mock-production-token

# --- Infrastructure Requirements ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DB_URI=postgresql://admin:admin@127.0.0.1:5433/autoresolve
POSTGRES_DSN=postgresql://admin:admin@127.0.0.1:5433/autoresolve
QDRANT_URL=http://localhost:6333
CLUSTER_TIMEZONE=
AUTORESOLVE_WEBHOOK_URL=http://localhost:8000/webhook/prometheus

# --- Database Credentials ---
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=autoresolve